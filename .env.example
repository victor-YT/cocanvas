# OpenAI API Platform key used to authenticate Codex App Server.
OPENAI_API_KEY=

# Optional overrides.
CODEX_APP_SERVER_MODEL=gpt-5.4
CODEX_APP_SERVER_TIMEOUT_MS=120000

# Keep this empty unless the codex binary is not on PATH.
CODEX_BINARY=codex

# OpenAI Responses model that converts raw Codex events into cocanvas graph events.
OPENAI_OBSERVER_MODEL=gpt-5.4
